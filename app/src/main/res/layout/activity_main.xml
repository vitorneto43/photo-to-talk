<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#F3F6FB">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Photo to Talk" android:textSize="29sp" android:textStyle="bold"
            android:textColor="#14263D" android:gravity="center" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Capture • Listen • Remember" android:textSize="16sp"
            android:textColor="#42546B" android:gravity="center" android:layout_marginBottom="12dp" />
        <androidx.camera.view.PreviewView android:id="@+id/previewView"
            android:layout_width="match_parent" android:layout_height="200dp"
            android:contentDescription="Live camera preview" android:background="#D8E2EF" />
        <ImageView android:id="@+id/photoPreview" android:layout_width="match_parent"
            android:layout_height="100dp" android:scaleType="centerInside"
            android:contentDescription="Last saved photo" android:visibility="gone" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Text script" android:textSize="16sp" android:textColor="#14263D"
            android:layout_marginTop="10dp" />
        <Spinner android:id="@+id/scriptSpinner" android:layout_width="match_parent"
            android:layout_height="52dp" android:contentDescription="Choose text writing system" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/captureButton" android:layout_width="0dp"
                android:layout_height="60dp" android:layout_weight="1" android:text="CAPTURE"
                android:textSize="16sp" />
            <Button android:id="@+id/importButton" android:layout_width="0dp"
                android:layout_height="60dp" android:layout_weight="1" android:text="IMPORT PHOTO"
                android:textSize="14sp" />
        </LinearLayout>
        <TextView android:id="@+id/statusText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Ready" android:textColor="#42546B"
            android:gravity="center" android:padding="10dp" android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/recognizedText" android:layout_width="match_parent"
            android:layout_height="180dp" android:background="#FFFFFF" android:padding="14dp"
            android:textColor="#14263D" android:textSize="19sp" android:scrollbars="vertical"
            android:contentDescription="Recognized text" android:textIsSelectable="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Reading voice" android:textColor="#14263D" android:textSize="16sp"
            android:layout_marginTop="10dp" />
        <Spinner android:id="@+id/languageSpinner" android:layout_width="match_parent"
            android:layout_height="52dp" android:contentDescription="Choose reading voice language" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/playButton" android:layout_width="0dp" android:layout_height="56dp"
                android:layout_weight="1" android:text="PLAY" />
            <Button android:id="@+id/pauseButton" android:layout_width="0dp" android:layout_height="56dp"
                android:layout_weight="1" android:text="PAUSE" />
            <Button android:id="@+id/stopButton" android:layout_width="0dp" android:layout_height="56dp"
                android:layout_weight="1" android:text="STOP" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/previousButton" android:layout_width="0dp" android:layout_height="56dp"
                android:layout_weight="1" android:text="PREVIOUS" />
            <Button android:id="@+id/nextButton" android:layout_width="0dp" android:layout_height="56dp"
                android:layout_weight="1" android:text="NEXT" />
            <Button android:id="@+id/repeatButton" android:layout_width="0dp" android:layout_height="56dp"
                android:layout_weight="1" android:text="REPEAT" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/historyButton" android:layout_width="0dp" android:layout_height="60dp"
                android:layout_weight="1" android:text="HISTORY" />
            <Button android:id="@+id/voiceButton" android:layout_width="0dp" android:layout_height="60dp"
                android:layout_weight="1" android:text="VOICE COMMAND" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Voice commands depend on the speech recognition service installed on your device."
            android:textSize="13sp" android:textColor="#42546B" android:paddingTop="8dp" />
    </LinearLayout>
</ScrollView>
